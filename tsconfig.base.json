{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "*": ["./*"],
      "@familytree/shared/*": ["./packages/shared/src/*"],
      "@familytree/shared": ["./packages/shared/src/index.ts"],
      "@frontend/*": ["./apps/frontend/*"],
      "@backend/*": ["./apps/backend/*"],
      "@components/*": ["./apps/frontend/components/*"],
      "@providers/*": ["./apps/frontend/providers/*"],
      "@public/*": ["./apps/frontend/public/*"],
      "@lib/*": ["./apps/frontend/lib/*"],
      "@hooks/*": ["./apps/frontend/hooks/*"]
    }
  }
}
